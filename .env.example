# ============================================================
# LLM 网关配置（EdgeOne Makers Agent）
#
# 用法：复制本文件为 .env，仅把 <...> 占位符替换为真实值。
#   cp .env.example .env
# 安全：.env 已被 .gitignore 忽略，切勿把真实 Key 提交到仓库。
#
# 读取方：仅后端 agents/chat/index.py（python-dotenv 的 load_dotenv()）
#         前端 Vite 与 cloud-functions/ 均不读取环境变量。
# 注意：  若系统环境变量已存在同名项，load_dotenv 默认不会覆盖它。
# ============================================================

# [必填] 模型网关 API Key
# 源码：os.getenv("AI_GATEWAY_API_KEY")，无默认值
# 获取：EdgeOne Makers 控制台 -> Models -> API Key（新建）
#       也可填任意 OpenAI 兼容服务商的 Key（BYOK）
AI_GATEWAY_API_KEY=<在此填入你的模型网关 API Key>

# [必填] 模型网关 Base URL
# 源码：os.getenv("AI_GATEWAY_BASE_URL")，无默认值
# Makers Models：https://ai-gateway.edgeone.link/v1
# 其它兼容服务：填其 OpenAI 兼容端点（通常以 /v1 结尾）
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# [可选] 模型 ID
# 源码：os.getenv("AI_GATEWAY_MODEL", "@makers/deepseek-v4-flash")
# 留空或删除本行时，代码使用默认值 @makers/deepseek-v4-flash（内置免费模型）
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ============================================================
# 出行决策 Agent —— 高德地图 WebService API（合规地图数据源）
# 用途：位置解析、附近商场检索、真实路面距离计算
# 申请：登录 https://console.amap.com -> 应用管理 -> 创建应用 -> 添加 Key
#       服务平台务必选「Web服务」；个人开发者实名认证后有免费额度。
# 安全：这是密钥，切勿提交；生产环境在 EdgeOne Makers 控制台配到环境变量。
# 兼容：旧变量名 TENCENT_MAP_KEY 仍可读取（兼容历史配置），优先用 AMAP_API_KEY。
# ============================================================

# [必填/出行功能] 高德地图 WebService API Key
# 源码：agents/_geo.py 读取 os.getenv("AMAP_API_KEY")
AMAP_API_KEY=<在此填入你的高德 Web服务 Key>